    "mip_abs_gap": 1e-7,
    "primal_feasibility_tolerance": 1e-8,
    "dual_feasibility_tolerance": 1e-8,
    "mip_feasibility_tolerance": 1e-8
  },
  "validation": {"energy_atol_kwh": 1e-6, "cost_atol_yuan": 1e-6, "integer_atol": 1e-7}
}
